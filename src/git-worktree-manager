#!/bin/sh

set -o errexit
set -o nounset
set -o pipefail

# git worktree manager – CLI.

###############################################################################
# Context and configuration.
###############################################################################

# Filenames for hooks.
INITIALIZATION_HOOK_FILENAME="init.sh"
OPEN_HOOK_FILENAME="open.sh"
ACTIVATION_HOOK_FILENAME="activate.sh"

# Initialize the locations required for the main operations of this application based on the
# configuration.
init_location_configuration() {
    # Initialize the location, where the projects live.
    projects_dir="${GWM_PROJECTS_DIR?Projects directory must be set.}"
    PROJECTS_DIR_ABS="$(abspath "$projects_dir")" ||
        exit_with_error "Invalid GWM_PROJECTS_DIR"

    # Initialize the location, where the worktrees live.
    worktrees_dir="${GWM_WORKTREES_DIR?Worktrees directory must be set.}"
    WORKTREES_DIR_ABS="$(abspath "$worktrees_dir")" ||
        exit_with_error "Invalid GWM_WORKTREES_DIR."
}

# Initialize the Git context of the current working directory.
init_git_context() {
    # Initialize the location of the root of the Git repository based on the current working
    # directory (the main repository, not a worktree).
    git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" ||
        exit_with_error "Not in a Git repository."
    REPO_ROOT_ABS="$(abspath "$git_common_dir/..")" ||
        exit_with_error "Cannot resolve repository root."

    # Layout validation: repository root must be a strict subdirectory of the projects directory.
    case "$REPO_ROOT_ABS" in
        "$PROJECTS_DIR_ABS"/*) ;;
        *) exit_with_error "Repository not inside projects directory." ;;
    esac

    # Initialize the relative path of the repository to the projects directory.
    REPO_REL="${REPO_ROOT_ABS#"$PROJECTS_DIR_ABS"/}"
}

init_context() {
    init_location_configuration
    init_git_context
}

###############################################################################
# Helper functions.
###############################################################################

exit_with_usage() {
    code="${1:-1}"
    bin_name="${0##*/}"
    cat <<EOF
git worktree manager – Manage Git worktrees.

Usage: $bin_name <command> [args]

COMMANDS
  init <branch>          Initialize a new worktree for the specified branch,
                         and trigger the "init" hook.
  open <worktree>        "Open the specified worktree", i.e., trigger the
                         "open" hook.
  activate <worktree>    "Activate the specified worktree", i.e., trigger the
                         "activate" hook.
  remove <worktree>      Remove the specified worktree.
  find <query>           Find a worktree and return its path.
  prune                  Prune worktree information.
  list                   List all worktrees.
  help                   Show this information.

Commands are interactive when possible, using fzf for selection.

HOOKS
  init        Runs when initializing a worktree ("$INITIALIZATION_HOOK_FILENAME").
  open        Runs when opening a worktree ("$OPEN_HOOK_FILENAME").
  activate    Runs when activating a worktree ("$ACTIVATION_HOOK_FILENAME").

Hook files can be placed per repository in their repository-specific worktrees
directory, and will be run, if present.

EXAMPLES
  $bin_name init feature/new-api
  $bin_name open
  $bin_name activate
  $bin_name find my-feature
EOF
    exit "$code"
}

exit_with_error() {
    message="$1"
    code="${2:-1}"
    printf "%s\n" "$message" >&2
    exit "$code"
}
#
# abspath DIR_PATH
# Print the canonical absolute path of the directory to stdout, returns non-zero on failure.
abspath() {
    if [ "$#" -ne 1 ]; then
        exit_with_error "abspath: Invalid number of arguments."
    fi

    (cd "$1" 2>/dev/null && pwd) || return 1
}
#
# normalize_dir_path PATH
# Normalize a directory path by removing trailing slashes.
normalize_dir_path() {
    if [ "$#" -ne 1 ]; then
        exit_with_error "normalize_dir_path: Invalid number of arguments."
    fi

    path="$1"
    normalized="${path%/}" # Remove trailing slashes.

    # If the result is empty, the input was "/" or "//".
    if [ -z "$normalized" ]; then
        exit_with_error "normalize_dir_path: Normalization result is root path."
    fi

    printf "%s\n" "$normalized"
}

# is_subdir_abs BASE_PATH_ABS SUBDIR_CANDIDATE_PATH_ABS
# Determine whether a the candidate is a strict subdirectory of the base directory. Expects absolute
# paths.
# Returns:
#   0, if SUBDIR_CANDIDATE_PATH_ABS is a subdirectory of BASE_PATH_ABS,
#   1, otherwise.
is_subdir_abs() {
    if [ "$#" -ne 2 ]; then
        exit_with_error "is_subdir_abs: Invalid number of arguments."
    fi

    base="$1"
    child="$2"
    case "$child" in
        "$base"/*) return 0 ;; # Strict sub directory only.
        *) return 1 ;;
    esac
}

# get_worktree_dir_abs BRANCH_NAME
# Get the absolute path to the worktree directory for the specified branch.
get_worktree_dir_abs() {
    if [ "$#" -ne 1 ]; then
        exit_with_error "get_worktree_dir_abs: Invalid number of arguments."
    fi

    branch_name="$1"
    dir_name="$(branch_name_to_dir_name "$branch_name")"
    printf "%s\n" "$WORKTREES_DIR_ABS/$REPO_REL/$dir_name"
}

# branch_name_to_dir_name BRANCH_NAME
# Get the normalized directory name for the specified branch.
branch_name_to_dir_name() {
    if [ "$#" -ne 1 ]; then
        exit_with_error "branch_name_to_dir_name: Invalid number of arguments."
    fi

    branch_name="$1"
    # Replace all slashes with underscores to prevent a nested directory.
    printf "%s\n" "$branch_name" | tr '/' '_'
}

# get_local_branch_name BRANCH_NAME
# Extract the local branch name from a branch reference (strips remote prefix if present).
get_local_branch_name() {
    if [ "$#" -ne 1 ]; then
        exit_with_error "get_local_branch_name: Invalid number of arguments."
    fi

    branch_name="$1"
    local_branch="$branch_name"

    for remote in $(git remote); do
        case "$branch_name" in
            "$remote"/*)
                local_branch="${branch_name#"$remote"/}"
                break
                ;;
        esac
    done

    printf "%s\n" "$local_branch"
}

# exec_hook EXECUTABLE_NAME WORKTREE_DIR_ABS
# Execute the specified executable with the specified worktree directory.
exec_hook() {
    if [ "$#" -ne 2 ]; then
        exit_with_error "exec_hook: Invalid number of arguments."
    fi

    executable_name="$1"
    worktree_dir="$2"

    # Only run hooks for worktrees inside the worktrees directory.
    is_subdir_abs "$WORKTREES_DIR_ABS" "$worktree_dir" || return 1

    executable="$(dirname "$worktree_dir")/$executable_name"
    if [ -f "$executable" ] && [ -x "$executable" ]; then
        "$executable" "$worktree_dir"
    fi

    return 0
}

###############################################################################
# Command operations.
###############################################################################

init_worktree() {
    query="$*"
    branch_name="$(
        git branch --all --format="%(refname:short)" |
            fzf --preview='git log --oneline -n10' --query "$query"
    )"

    local_branch_name="$(get_local_branch_name "$branch_name")"

    worktree_dir_abs="$(get_worktree_dir_abs "$local_branch_name")" ||
        exit_with_error "Failed to get worktree directory."

    # If remote branch selected, create local tracking branch. Otherwise use branch directly
    if [ "$local_branch_name" != "$branch_name" ]; then
        if ! git worktree add -b "$local_branch_name" "$worktree_dir_abs" "$branch_name"; then
            exit_with_error "Failed to add worktree at $worktree_dir_abs."
        fi
    else
        if ! git worktree add "$worktree_dir_abs" "$branch_name"; then
            exit_with_error "Failed to add worktree at $worktree_dir_abs."
        fi
    fi
    printf "%s\n" "Added worktree at $worktree_dir_abs."

    exec_hook "$INITIALIZATION_HOOK_FILENAME" "$worktree_dir_abs"
    printf "%s\n" "Initialized worktree at $worktree_dir_abs."
}

open_worktree() {
    query="$*"
    worktree_dir_abs="$(
        git worktree list |
            fzf --preview='git log --oneline -n10 {2}' --query "$query" |
            awk '{print $1}'
    )"
    exec_hook "$OPEN_HOOK_FILENAME" "$worktree_dir_abs"
    printf "%s\n" "Opened worktree at $worktree_dir_abs."
}

activate_worktree() {
    query="$*"
    worktree_dir_abs="$(
        git worktree list |
            fzf --preview='git log --oneline -n10 {2}' --query "$query" |
            awk '{print $1}'
    )"
    exec_hook "$ACTIVATION_HOOK_FILENAME" "$worktree_dir_abs"
    printf "%s\n" "Activated worktree at $worktree_dir_abs."
}

remove_worktree() {
    query="$*"
    worktree_dir="$(
        git worktree list |
            fzf --preview='git log --oneline -n10 {2}' --query "$query" |
            awk '{print $1}'
    )"
    if git worktree remove "${worktree_dir}"; then
        printf "%s\n" "Removed worktree at $worktree_dir."
    else
        exit_with_error "Failed to remove worktree at $worktree_dir."
    fi
}

find_worktree() {
    query="$*"
    printf "%s\n" "$(
        git worktree list |
            fzf --preview='git log --oneline -n10 {2}' --query "$query" |
            awk '{print $1}'
    )"
}

prune_worktrees() {
    if git worktree prune; then
        printf "%s\n" "Pruned worktree information."
    else
        exit_with_error "Failed to prune worktree information."
    fi
}

list_worktrees() {
    git worktree list
}

debug() {
    printf "GWM_PROJECTS_DIR=%s\n" "${GWM_PROJECTS_DIR:-""}"
    printf "GWM_WORKTREES_DIR=%s\n" "${GWM_WORKTREES_DIR:-""}"
    printf "PROJECTS_DIR_ABS=%s\n" "${PROJECTS_DIR_ABS:-""}"
    printf "WORKTREES_DIR_ABS=%s\n" "${WORKTREES_DIR_ABS:-""}"
    printf "REPO_ROOT_ABS=%s\n" "${REPO_ROOT_ABS:-""}"
    printf "REPO_REL=%s\n" "${REPO_REL:-""}"
}

###############################################################################
# Entry point.
###############################################################################

main() {
    if [ "$#" -eq 0 ]; then
        exit_with_usage 0
    fi

    command="$1"
    shift

    # Route command to operation.
    case "$command" in
        init | open | activate | remove | find)
            operation="${command}_worktree"
            ;;
        prune | list)
            operation="${command}_worktrees"
            ;;
        help | --help | -h)
            exit_with_usage 0
            ;;
        *)
            exit_with_usage 1
            ;;
    esac

    # At this point, we have a valid command/operation. Initialize context.
    init_context

    # Execute the operation.
    "$operation" "$@"
}

main "$@"
